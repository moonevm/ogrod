generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String @id
  userId          BigInt @unique
  latestMessageId BigInt @unique

  aiQuestions Int @default(10)

  active      Boolean      @default(true)
  weatherLogs WeatherLog[]

  createdAt DateTime @default(now())
}

model WeatherLog {
  id String @id

  summary     String
  weatherData Json
  message     String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
