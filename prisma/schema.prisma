generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String @id
  userId          BigInt @unique
  latestMessageId BigInt @unique

  active Boolean @default(true)

  createdAt DateTime @default(now())
}

model WeatherLog {
  id String @id

  summary     String
  weatherData Json

  createedAt DateTime @default(now())
}
